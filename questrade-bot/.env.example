# ============================================================
# QUESTRADE TRADING BOT - CONFIGURATION
# ============================================================

# --- Questrade API ---
# Get this by registering a "Personal App" in Questrade IQ Edge
# under Settings -> API Access -> App Registration.
# This token can only be used ONCE - the bot will save the new
# rotated refresh token to data/questrade_tokens.json automatically.
QUESTRADE_REFRESH_TOKEN=your-questrade-refresh-token-here

# Use the practice login for paper trading with a simulated account,
# or the live login for a real account.
#   Practice: https://practicelogin.questrade.com
#   Live:     https://login.questrade.com
QUESTRADE_AUTH_URL=https://practicelogin.questrade.com/oauth2/token

# Optional: pin to a specific account number. If blank, the bot uses
# the first active account returned by the API.
QUESTRADE_ACCOUNT_NUMBER=

# --- Trading mode ---
# "paper"  -> bot runs its full loop and logs intended trades, no alerts sent.
# "alert"  -> bot sends entry/exit alerts (Telegram) for the trader to act on
#             manually. Questrade restricts order placement to Partner Developer
#             apps, so this bot cannot place orders itself - it analyzes the
#             market and tells you what to do, then reconciles against your
#             actual broker positions to confirm whether you acted on it.
TRADING_MODE=paper

# --- Notifications (used in "alert" mode) ---
# Create a bot via @BotFather on Telegram to get a token, then message your
# bot once and call https://api.telegram.org/bot<token>/getUpdates to find
# your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How long (minutes) an entry alert can stay unconfirmed (not yet seen in
# your broker positions) before the bot gives up on it and allows a fresh signal.
SUGGESTION_EXPIRY_MINUTES=30

# --- Claude (used for hybrid signal review) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Strategy / universe ---
WATCHLIST=AAPL,MSFT,TSLA,SPY,CNQ.TO,CVE.TO,BB.TO
CANDLE_INTERVAL=FifteenMinutes
LOOKBACK_CANDLES=200
POLL_INTERVAL_MS=60000

# --- Risk management ---
# Max % of account equity risked on a single trade (distance to stop loss)
MAX_RISK_PER_TRADE_PCT=1
# Max % of account equity allowed to be lost in a single day before
# the bot halts all new trades (circuit breaker)
MAX_DAILY_LOSS_PCT=3
# Max number of concurrent open positions
MAX_OPEN_POSITIONS=3
# Max number of new entries per day (separate from open positions)
MAX_TRADES_PER_DAY=6
# ATR multiplier used to set stop-loss / take-profit distances
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=3

# --- Market hours (bot will idle outside these hours) ---
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
